{
  "expo": {
    "name": "NexuLex AI",
    "slug": "doka",
    "scheme": [
      "contractshield",
      "nexulex"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nexulex.ai",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "NSMicrophoneUsageDescription": "NexuLex AI uses the microphone so you can ask legal questions by voice.",
        "NSSpeechRecognitionUsageDescription": "NexuLex AI uses speech recognition to turn your voice into text.",
        "NSPhotoLibraryUsageDescription": "NexuLex AI opens your photo library only so you can pick contract photos to analyze.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "com.nexulex.ai",
            "CFBundleURLSchemes": [
              "contractshield",
              "nexulex"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-mono.png",
        "backgroundColor": "#0A0F1D"
      },
      "package": "com.nexulex.ai",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "softwareKeyboardLayoutMode": "pan",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "contractshield"
            },
            {
              "scheme": "nexulex"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "contractshield",
              "host": "auth",
              "pathPrefix": "/callback"
            },
            {
              "scheme": "nexulex",
              "host": "auth",
              "pathPrefix": "/callback"
            },
            {
              "scheme": "contractshield",
              "host": "expo-development-client"
            },
            {
              "scheme": "nexulex",
              "host": "expo-development-client"
            },
            {
              "scheme": "contractshield",
              "host": "verify-email"
            },
            {
              "scheme": "contractshield",
              "host": "reset-password"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "locales": {
      "tr": "./locales/ios/tr.json",
      "en": "./locales/ios/en.json",
      "de": "./locales/ios/de.json",
      "fr": "./locales/ios/fr.json",
      "es": "./locales/ios/es.json",
      "ar": "./locales/ios/ar.json",
      "it": "./locales/ios/it.json",
      "zh": "./locales/ios/zh.json",
      "ru": "./locales/ios/ru.json",
      "fa": "./locales/ios/fa.json",
      "ja": "./locales/ios/ja.json",
      "pt": "./locales/ios/pt.json",
      "nl": "./locales/ios/nl.json"
    },
    "plugins": [
      "expo-sharing",
      "expo-dev-client",
      "./plugins/withAudioPermissions",
      "./plugins/withAndroidNativeBuild",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "35.0.0",
            "ndkVersion": "27.1.12297006",
            "packagingOptions": {
              "pickFirst": [
                "**/libc++_shared.so",
                "**/libjsi.so",
                "**/libfbjni.so",
                "**/libreactnative.so",
                "**/libhermes.so",
                "**/libhermesvm.so"
              ]
            }
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#D4B27A",
          "defaultChannel": "trap-calendar",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "NexuLex AI uses the microphone so you can ask legal questions by voice."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "NexuLex AI uses the microphone so you can ask legal questions by voice.",
          "speechRecognitionPermission": "NexuLex AI uses speech recognition to turn your voice into text."
        }
      ],
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0F1D",
          "android": {
            "image": "./assets/splash-icon.png",
            "imageWidth": 200,
            "resizeMode": "contain"
          },
          "ios": {
            "image": "./assets/splash.png",
            "resizeMode": "contain",
            "enableFullScreenImage_legacy": true
          }
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "79964394-bb0f-41f7-9236-3e6f15d99106"
      }
    },
    "owner": "nexulexs-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/79964394-bb0f-41f7-9236-3e6f15d99106"
    }
  }
}
